# Leo Green Farm — Environment Variables Template
# Copy this file to .env and fill in values. Never commit real credentials.

PORT=3000
NODE_ENV=development

# Set to "true" only when running behind a reverse proxy/load balancer
# (needed so rate limiting sees real client IPs).
TRUST_PROXY=false

# Google Gemini API key for the server-side AI assistant and crop photo analysis.
# Obtain one at https://aistudio.google.com/ — keep it server-side only.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=

# data.gov.in API key for live Agmarknet mandi prices.
# Register at https://data.gov.in/ — without it the Mandi tab shows an honest "not configured" state.
DATA_GOV_IN_API_KEY=
