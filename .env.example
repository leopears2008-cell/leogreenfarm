# Leo Green Farm: environment variables. Copy to .env (or export them) and fill in. Never commit real keys.

PORT=3000

# Google Gemini API key (server-side only). Get one at https://aistudio.google.com/
# Without it, chat gives general offline advice and crop scanning is disabled.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=

# Set to 1 only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=
