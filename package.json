{
  "name": "leogreenfarm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python app.py",
    "build": "vite build",
    "start": "python -m gunicorn app:app --bind 0.0.0.0:${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "python -m unittest discover -s tests -t . && npm run test:web",
    "test:web": "node --experimental-strip-types --test tests/translations.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vite": "^6.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
